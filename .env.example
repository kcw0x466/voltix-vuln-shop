VOLTIX_HOST=127.0.0.1
VOLTIX_PORT=5000
VOLTIX_DB=instance/voltix.sqlite3
# Set a long random secret before sharing a lab instance.
VOLTIX_SECRET=replace-with-a-random-secret
VOLTIX_LAB_MODE=0
# comma-separated IDs or all; requires LAB_MODE=1
VOLTIX_VULNS=all
# High-risk features only in Compose worker, never directly on host.
VOLTIX_WORKER_URL=
VOLTIX_WORKER_TOKEN=
